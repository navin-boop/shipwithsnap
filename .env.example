# Copy to .env.local for local dev. On Vercel, add these under Project → Settings → Environment Variables.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=                      # openssl rand -base64 32

# Database (Neon Postgres — pooled URL for the app, direct URL for migrations)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Redis (Upstash) — rate cache, address cache, rate limits, idempotency keys
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# EasyPost — use the TEST key until launch; test labels are free and fake
EASYPOST_API_KEY=
EASYPOST_WEBHOOK_SECRET=

# Stripe — test mode keys until launch
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Background jobs + cron (Inngest)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Label files (Vercel Blob, private access)
BLOB_READ_WRITE_TOKEN=

# Transactional email — provider still [TBD]
EMAIL_API_KEY=
EMAIL_FROM=labels@shipwithsnap.com
