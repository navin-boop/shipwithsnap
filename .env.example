# Copy to .env.local for local dev. On Vercel, add these under Project → Settings → Environment Variables.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=                      # openssl rand -base64 32

# Database (Neon Postgres — pooled URL for the app, direct URL for migrations)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# EasyPost — TEST key (EZTK…) everywhere except Vercel Production, which gets the live key (EZAK…).
# Without a key the app uses a built-in fake provider (deterministic rates, fake labels).
EASYPOST_API_KEY=
EASYPOST_WEBHOOK_SECRET=          # from the EasyPost webhook you point at /api/webhooks/easypost

# Stripe — test mode keys (pk_test_/sk_test_) until phase 4 is built and tested.
# On Vercel the two kinds of key need different variable Types:
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY -> Type "Config". A publishable key is meant to reach the
#     browser, so the NEXT_PUBLIC_ prefix is correct. Marking it "Secret" makes Vercel warn about
#     the public prefix, and a saved Secret cannot be flipped to Config — delete it and re-add it.
#   STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET -> Type "Secret", and never a NEXT_PUBLIC_ prefix.
# With no STRIPE_SECRET_KEY the whole billing system is inert and labels are bought without a
# charge, so the app stays usable before the keys are in place.
# ALLOW_LIVE_STRIPE=1 lets a live key run outside Vercel Production. Do not set it casually.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=      # from the Stripe webhook pointed at /api/webhooks/stripe

# Google sign-in (optional — the button hides itself without these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email via Resend (optional — emails are logged to the console without it)
RESEND_API_KEY=            # EMAIL_API_KEY is accepted as an alias
EMAIL_FROM="Ship with Snap <labels@shipwithsnap.com>"

# Scheduled work: Vercel Cron calls /api/cron/hourly with this bearer token (Vercel sets it for you)
CRON_SECRET=

# Only set this to buy REAL postage outside Vercel Production with a live EasyPost key
# ALLOW_LIVE_EASYPOST=1
